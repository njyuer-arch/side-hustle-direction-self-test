{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "side-hustle-feedback-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 3600 }
    }
  ]
}
